#!/usr/bin/env sh
# Copyright (c) Microsoft Corporation.
# Licensed under the MIT license.

# Legacy command name delegates to the canonical source launcher.
# Connection fields come from process env or dotenv, never shell sourcing.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
repo=$(CDPATH= cd -- "$here/.." && pwd) || exit 1
cd "$repo" || exit 1
exec pnpm start:daemon "$@"
